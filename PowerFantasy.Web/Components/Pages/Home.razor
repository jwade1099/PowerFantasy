@page "/"
@attribute [AllowAnonymous]

<PageTitle>PowerFantasy</PageTitle>

<div class="landing">
    <h1>PowerFantasy</h1>
    <p class="text-muted lead">Weekly power-rankings polls for your Sleeper fantasy football league.</p>

    <div class="landing-actions">
        <a class="btn btn-primary" href="/commissioner/signup">Sign up your league</a>
        <a class="btn btn-outline-secondary" href="/commissioner/login">Commissioner log in</a>
    </div>

    <p class="text-muted mt-4">
        Voting in a league already? Use the link your commissioner shared with you &mdash;
        there's nothing to sign up for.
    </p>
</div>
