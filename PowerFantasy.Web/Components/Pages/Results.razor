@page "/dashboard/results/{PollId:guid}"
@attribute [Authorize]
@rendermode InteractiveServer
@inject PowerFantasyApiClient Api

<PageTitle>Power Rankings Results</PageTitle>

@if (results is null && loadError is null)
{
    <p><em>Loading results...</em></p>
}
else if (loadError is not null)
{
    <div class="alert alert-danger">@loadError</div>
}
else if (results is not null)
{
    <h1>Week @results.Week Power Rankings</h1>
    <p class="text-muted mb-4">@results.VotesSubmitted of @results.TotalVoters teams have voted</p>

    <table class="table align-middle">
        <thead>
            <tr>
                <th>#</th>
                <th>Team</th>
                <th>Manager</th>
                <th>Record</th>
                <th>Average rank</th>
                <th>Votes counted</th>
            </tr>
        </thead>
        <tbody>
            @for (var i = 0; i < results.Rankings.Count; i++)
            {
                var team = results.Rankings[i];
                <tr>
                    <td>@RankBadge( i )</td>
                    <td>
                        @if (AvatarHelper.Thumb( team.AvatarUrl ) is { } avatar)
                        {
                            <img src="@avatar" alt="" width="28" height="28" class="rounded-circle me-2" />
                        }
                        <span class="fw-semibold">@team.TeamName</span>
                    </td>
                    <td class="text-muted">@team.ManagerName</td>
                    <td>@FormatRecord( team )</td>
                    <td>@team.AverageRank</td>
                    <td>@team.VoteCount</td>
                </tr>
            }
        </tbody>
    </table>

    <h2 class="h5 section-heading mt-5">Individual ballots</h2>
    @if (ballots.Count == 0)
    {
        <p class="text-muted">No ballots submitted yet.</p>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
            @foreach (var ballot in ballots)
            {
                <div class="col">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="fw-semibold">@ballot.VoterTeamName</div>
                            <div class="text-muted small mb-2">
                                @ballot.VoterManagerName &middot; @ballot.SubmittedAt.ToUniversalTime().ToString( "MMM d, h:mm tt" ) UTC
                            </div>
                            <ol class="ballot-list">
                                @foreach (var rank in ballot.Rankings)
                                {
                                    <li class="@(rank.TeamId == ballot.VoterTeamId ? "ballot-self" : "")">
                                        <span class="ballot-rank">@rank.Rank</span>
                                        @rank.TeamName
                                    </li>
                                }
                            </ol>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (nonVoters.Count > 0)
    {
        <p class="text-muted mt-4">
            Haven't voted yet: @string.Join( ", ", nonVoters )
        </p>
    }

    <p class="mt-4"><a href="/dashboard/history">&larr; Back to history</a></p>
}

@code {
    [Parameter] public Guid PollId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private PollResultsDto? results;
    private List<BallotDto> ballots = [];
    private List<string> nonVoters = [];
    private string? loadError;

    private static string FormatRecord( PollResultDto team ) =>
        team.Ties > 0 ? $"{team.Wins}-{team.Losses}-{team.Ties}" : $"{team.Wins}-{team.Losses}";

    private static string RankBadge( int index ) => index switch
    {
        0 => "🥇",
        1 => "🥈",
        2 => "🥉",
        _ => (index + 1).ToString()
    };

    protected override async Task OnParametersSetAsync() => await Load();

    private async Task Load()
    {
        try
        {
            var authState = await AuthState!;
            var leagueId = LeagueClaims.GetLeagueId( authState.User );
            if (leagueId is null)
            {
                loadError = "No league is linked to your account.";
                return;
            }

            results = await Api.GetResultsAsync( leagueId.Value, PollId );
            if (results is null)
            {
                loadError = "That poll doesn't exist.";
                return;
            }

            ballots = await Api.GetBallotsAsync( leagueId.Value, PollId );
            var voterIds = ballots.Select( b => b.VoterTeamId ).ToHashSet();
            nonVoters = results.Rankings
                .Where( r => !voterIds.Contains( r.TeamId ) )
                .Select( r => r.TeamName )
                .OrderBy( name => name )
                .ToList();
        }
        catch (Exception ex)
        {
            loadError = $"Couldn't load results: {ex.Message}";
        }
    }
}
