<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">PowerFantasy</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="dashboard/voting">
                        <span class="bi bi-link-45deg" aria-hidden="true"></span> Voting
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="dashboard">
                        <span class="bi bi-bar-chart-fill" aria-hidden="true"></span> Dashboard
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="dashboard/history">
                        <span class="bi bi-list-nested" aria-hidden="true"></span> History
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <form action="account/logout" method="post">
                        <AntiforgeryToken />
                        <button type="submit" class="nav-link logout-link">
                            <span class="bi bi-box-arrow-right" aria-hidden="true"></span> Log out
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="commissioner/login">
                        <span class="bi bi-box-arrow-in-right" aria-hidden="true"></span> Commissioner log in
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="commissioner/signup">
                        <span class="bi bi-plus-square-fill" aria-hidden="true"></span> Sign up your league
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>
